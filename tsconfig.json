{
  // Checagem de tipos via JSDoc (sem compilar). Domínio, infraestrutura, casos de
  // uso, service worker, configuração e o estado do painel são checados; a
  // renderização (ui/painel.js), content/, entries/ e o leitor de QR ainda não.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "skipLibCheck": true
  },
  "include": [
    "src/config.js",
    "src/domain/**/*.js",
    "src/infra/**/*.js",
    "src/app/**/*.js",
    "src/background/**/*.js",
    "src/ui/state.js"
  ],
  "exclude": ["src/infra/qr/reader.js"]
}
