{
  "manifest_version": 3,
  "name": "SIGA – Validador de Despesas",
  "short_name": "Validador SIGA",
  "version": "0.1.4",
  "description": "Confere cada despesa do SIGA contra a nota fiscal anexada (valor, CNPJ do consumidor, forma de pagamento, data e número) usando o QR Code da NFC-e e a consulta oficial da SEFAZ-SP.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://siga.congregacao.org.br/*",
    "https://*.blob.core.windows.net/*",
    "https://www.nfce.fazenda.sp.gov.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Validar despesas do SIGA",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://siga.congregacao.org.br/*"],
      "js": ["bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://siga.congregacao.org.br/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
